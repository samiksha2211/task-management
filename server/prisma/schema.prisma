generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                   @id @default(cuid())
  name                      String
  email                     String                   @unique
  password                  String
  designation               String
  role                      Role                     @default(OFFICER)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  avatar                    String?
  resetToken                String?
  resetTokenExpires         DateTime?
  department                String?
  isActive                  Boolean                  @default(true)
  mobileNumber              String?                  @unique
  notifications             Notification[]
  tasks                     Task[]
  additionalTaskAssignments TaskAdditionalAssignee[]
  taskOfficerUpdates        TaskOfficerUpdate[]
  uploadedAttachments       TaskAttachment[]
  scheduleEvents            TaskScheduleEvent[]

  @@index([designation])
}

model Task {
  id          String   @id @default(cuid())
  // Readable task ID shown in the app and PDFs.
  taskNumber  Int      @unique @default(autoincrement())
  title       String
  description String?
  date        DateTime

  dueDate DateTime

  remarks        String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?

  officerId       String
  priority        String?
  clientRequestId String? @unique

  // Action plan
  actionPlan    String?
  actionPlanTdc DateTime?

  status    TaskStatus @default(PENDING)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Monday meeting scheduling. All nullable / defaulted so existing tasks are
  // untouched: a task with no discussionFrequency is "not yet scheduled" and
  // never appears on an agenda until a user assigns one.
  discussionFrequency        DiscussionFrequency?
  // MONTHLY tasks: allocated Monday of every month (1-5; a 5th Monday falls
  // back to the month's last Monday). Null = 1st.
  monthlyMondayOrdinal       Int?
  // FORTNIGHTLY tasks: a Monday the alternate-week cycle runs from.
  fortnightAnchor            DateTime?            @db.Date
  lastDiscussedAt            DateTime?            @db.Date
  nextDiscussionDate         DateTime?            @db.Date
  // The date the frequency rule had produced before a deferral / bring-forward.
  originalDiscussionDate     DateTime?            @db.Date
  scheduleState              ScheduleState        @default(SCHEDULED)
  scheduleReason             String?
  estimatedDiscussionMinutes Int?
  isBlocked                  Boolean              @default(false)
  flaggedForReview           Boolean              @default(false)
  latestReviewNote           String?
  latestReviewAt             DateTime?

  notifications       Notification[]
  officer             User                     @relation(fields: [officerId], references: [id])
  additionalAssignees TaskAdditionalAssignee[]
  officerUpdates      TaskOfficerUpdate[]
  attachments         TaskAttachment[]
  agendaItems         MeetingAgendaItem[]
  scheduleEvents      TaskScheduleEvent[]

  @@index([status])
  @@index([officerId])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([nextDiscussionDate])
}

// One Monday meeting. meetingDate is unique, so reopening or regenerating an
// agenda always works on the same record.
model Meeting {
  id                   String        @id @default(cuid())
  meetingDate          DateTime      @unique @db.Date
  status               MeetingStatus @default(DRAFT)
  durationLimitMinutes Int           @default(90)
  notes                String?
  reportUrl            String?
  reportName           String?
  finalizedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  items  MeetingAgendaItem[]
  events TaskScheduleEvent[]
}

model MeetingAgendaItem {
  id                     String          @id @default(cuid())
  meetingId              String
  taskId                 String
  section                AgendaSection
  inclusion              AgendaInclusion
  reason                 String
  estimatedMinutes       Int             @default(0)
  outcome                AgendaOutcome   @default(PENDING)
  discussionNotes        String?
  decisions              String?
  deferredTo             DateTime?       @db.Date
  deferReason            String?
  // Task schedule before the outcome was recorded, so an outcome can be undone.
  prevLastDiscussedAt    DateTime?       @db.Date
  prevNextDiscussionDate DateTime?       @db.Date
  prevScheduleState      ScheduleState?
  prevOriginalDate       DateTime?       @db.Date
  prevScheduleReason     String?
  outcomeAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([meetingId, taskId])
  @@index([taskId])
}

// Audit trail of every scheduling change.
model TaskScheduleEvent {
  id            String               @id @default(cuid())
  taskId        String
  meetingId     String?
  userId        String?
  type          ScheduleEventType
  fromDate      DateTime?            @db.Date
  toDate        DateTime?            @db.Date
  fromFrequency DiscussionFrequency?
  toFrequency   DiscussionFrequency?
  reason        String?
  createdAt     DateTime             @default(now())

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([meetingId])
}

enum DiscussionFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ScheduleState {
  SCHEDULED
  DEFERRED
  BROUGHT_FORWARD
  PINNED
  CANCELLED
}

enum MeetingStatus {
  DRAFT
  FINALIZED
  CLOSED
}

enum AgendaSection {
  URGENT
  BLOCKED_OVERDUE
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  NEW
}

enum AgendaInclusion {
  DUE
  BROUGHT_FORWARD
  MANUAL
}

enum AgendaOutcome {
  PENDING
  DISCUSSED
  NOT_DISCUSSED
  DEFERRED
}

enum ScheduleEventType {
  INITIALIZED
  FREQUENCY_CHANGED
  RESCHEDULED
  BROUGHT_FORWARD
  DEFERRED
  DISCUSSED
  DISCUSSION_UNDONE
  REVIEW_UPDATED
  ADDED_TO_AGENDA
  REMOVED_FROM_AGENDA
  COMPLETED
  CANCELLED
}

model TaskAdditionalAssignee {
  id        String   @id @default(cuid())
  taskId    String
  officerId String
  createdAt DateTime @default(now())

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  officer User @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@unique([taskId, officerId])
  @@index([taskId])
  @@index([officerId])
}

model TaskOfficerUpdate {
  id             String   @id @default(cuid())
  taskId         String
  officerId      String
  actionPlan     String?
  remark         String?
  attachmentUrl  String?
  attachmentName String?
  attachmentType String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  officer     User             @relation(fields: [officerId], references: [id], onDelete: Cascade)
  attachments TaskAttachment[]

  @@index([taskId])
  @@index([officerId])
}

// A file or Google Sheets link attached to a task. officerUpdateId = null
// means a DRM attachment on the task; otherwise it belongs to that BO entry.
// (The single attachment columns on Task / TaskOfficerUpdate are legacy and
// were copied into this table.)
model TaskAttachment {
  id              String         @id @default(cuid())
  taskId          String
  officerUpdateId String?
  kind            AttachmentKind
  url             String
  name            String
  mimeType        String?
  sizeBytes       Int?
  uploadedById    String?
  createdAt       DateTime       @default(now())

  task          Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  officerUpdate TaskOfficerUpdate? @relation(fields: [officerUpdateId], references: [id], onDelete: Cascade)
  uploadedBy    User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([officerUpdateId])
  @@index([url])
}

enum AttachmentKind {
  FILE
  LINK
}

model Notification {
  id                String             @id @default(cuid())
  taskId            String?
  officerId         String?
  type              NotificationType
  message           String
  mobileNumber      String
  status            NotificationStatus @default(PENDING)
  scheduleFor       DateTime
  sentAt            DateTime?
  ProviderMessageID String?            @unique
  errorMessage      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  officer           User?              @relation(fields: [officerId], references: [id], onDelete: Cascade)
  task              Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, officerId, type, scheduleFor])
  @@index([officerId])
  @@index([taskId])
  @@index([scheduleFor])
}

enum Role {
  ADMIN
  OFFICER
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum NotificationType {
  TASK_ASSIGNED
  WEEKLY_REMINDER
  DUE_REMINDER
  OVERDUE_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}
